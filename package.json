{
  "name": "bientot",
  "version": "0.1.0",
  "description": "Plan the day you'll actually have.",
  "scripts": {
    "prepare": "husky",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\""
  },
  "keywords": [],
  "author": "Shreya Gosavi",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "markdownlint-cli2": "^0.24.1",
    "prettier": "3.10.1"
  },
  "lint-staged": {
    "*.md": [
      "prettier --write",
      "markdownlint-cli2"
    ],
    "*.{js,mjs,cjs,ts,tsx,json,jsonc,css,yml,yaml}": "prettier --write"
  }
}
